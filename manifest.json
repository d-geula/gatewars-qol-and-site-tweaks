{
  "manifest_version": 2,
  "name": "Battlefield Row Filter",
  "version": "2.0",
  "description": "Hides inactive players and those below a treasury threshold",
  "icons": {
    "48": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://main.gatewa.rs/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Battlefield Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://main.gatewa.rs/battlefield.php*", "*://main.gatewa.rs/battlefieldE.php*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}